+// ExternalServerHint is the message shown when an externally managed Dolt
+// server is unreachable. It deliberately does not mention `bd dolt start`.
+func ExternalServerHint(host string, port int) string {
+	if host == "" {
+		host = "127.0.0.1"
+	}
+	return fmt.Sprintf("The shared Dolt server at %s:%d is unreachable. Check the server. Do not run bd dolt start here.", host, port)
 }
 
+// isExternalServer reports whether the configured server is managed outside
+// bd: a non-local host, or external mode (explicit port, --external).
+// Shared-server mode is excluded because bd starts that server itself.
+func isExternalServer(cfg *Config, beadsDir string) bool {
+	if !isLocalHost(cfg.ServerHost) {
+		return true
+	}
+	return doltserver.ResolveServerMode(beadsDir) == doltserver.ServerModeExternal && !doltserver.IsSharedServerMode()
+}
